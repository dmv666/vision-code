{
  "output": {
    "path": "renders/neon_core.mp4",
    "width": 3840, "height": 2160, "fps": 60,
    "codec": "h264", "quality": "high", "hardware": "auto",
    "supersample": 2,
    "motion_blur": { "samples": 2, "shutter": 0.5 }
  },
  "palette": { "preset": "neon", "intensity": 1.3 },
  "animation": {
    "bpm": 128, "bars": 4,
    "speed": 1.0, "rotation": 0.133, "wobble": 0.133, "hue_cycles": 0.133,
    "pulse_strength": 0.85, "pulse_decay": 6.0
  },
  "layers": [
    {
      "pattern": "particle_sphere",
      "params": { "count": 240, "shells": 3, "size": 0.006, "displacement": 0.12, "camera_distance": 3.4 }
    },
    {
      "pattern": "kaleidoscope",
      "opacity": 0.5,
      "params": { "segments": 16, "zoom": 0.45, "complexity": 2, "line_width": 0.003 },
      "animation": { "speed": 0.267, "rotation": -0.133 }
    },
    {
      "pattern": "starfield",
      "opacity": 0.8,
      "params": { "layers": 14, "density": 0.08, "size": 0.02, "streak": 3.0 },
      "palette": { "colors": ["#ffffff", "#00f0ff"] },
      "animation": { "speed": 0.533, "beat_multiplier": 2 }
    }
  ],
  "post": {
    "exposure": 1.0, "bloom": 0.75, "bloom_radius": 1.2,
    "vignette": 0.45, "grain": 0.015, "chromatic_aberration": 0.002,
    "saturation": 1.1, "contrast": 1.05
  }
}
