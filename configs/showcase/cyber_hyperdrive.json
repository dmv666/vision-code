{
  "output": {
    "path": "renders/cyber_hyperdrive.mp4",
    "width": 3840, "height": 2160, "fps": 60,
    "codec": "hevc", "quality": "high", "hardware": "auto",
    "supersample": 2,
    "motion_blur": { "samples": 4, "shutter": 0.6 }
  },
  "palette": { "preset": "cyberpunk", "intensity": 1.25 },
  "animation": {
    "bpm": 128, "bars": 8,
    "speed": 2.0, "rotation": 0.0667, "wobble": 0.133, "hue_cycles": 0,
    "pulse_strength": 0.75, "pulse_decay": 5.5
  },
  "layers": [
    {
      "pattern": "hex_tunnel",
      "params": {
        "sides": 8, "segment": 0.8, "line_width": 0.025, "twist": 0.08,
        "grid": 4, "fog": 20, "panel_density": 0.18,
        "streams": 0.9, "stream_speed": 2.0, "pulse_speed": 0.06
      }
    },
    {
      "pattern": "starfield",
      "opacity": 0.9,
      "params": { "layers": 18, "density": 0.1, "size": 0.025, "streak": 4.0, "far_scale": 50 },
      "palette": { "colors": ["#ffffff", "#05d9e8", "#d1f7ff"] },
      "animation": { "speed": 0.8, "rotation": -0.0667, "beat_multiplier": 2 }
    },
    {
      "pattern": "kaleidoscope",
      "opacity": 0.35,
      "params": { "segments": 8, "zoom": 0.5, "complexity": 2, "line_width": 0.0037 },
      "animation": { "speed": 0.267, "rotation": -0.133, "hue_cycles": 0.0667 }
    }
  ],
  "post": {
    "exposure": 1.0, "bloom": 0.6, "bloom_radius": 1.1,
    "vignette": 0.45, "grain": 0.015, "chromatic_aberration": 0.002,
    "saturation": 1.1, "contrast": 1.05
  }
}
