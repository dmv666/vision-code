{
  "output": {
    "path": "renders/synthwave_horizon.mp4",
    "width": 3840, "height": 2160, "fps": 60,
    "codec": "hevc", "quality": "high", "hardware": "auto",
    "supersample": 2,
    "motion_blur": { "samples": 3, "shutter": 0.5 }
  },
  "palette": { "preset": "sunset", "intensity": 1.3 },
  "animation": {
    "bpm": 120, "bars": 8,
    "speed": 1.0, "rotation": 0, "wobble": 0.0625, "hue_cycles": 0,
    "pulse_strength": 0.6, "pulse_decay": 5.0
  },
  "layers": [
    {
      "pattern": "organic_waves",
      "params": { "horizon": 0.12, "scale": 0.9, "bands": 14, "warp": 1.0, "line_width": 0.03, "flow_radius": 0.5 }
    },
    {
      "pattern": "starfield",
      "opacity": 0.85,
      "params": { "layers": 12, "density": 0.08, "size": 0.02, "streak": 0.5, "twinkle": 0.7, "far_scale": 30 },
      "palette": { "colors": ["#ffffff", "#ffbe0b", "#ff006e"] },
      "animation": { "speed": 0.0625, "rotation": 0.0625 }
    },
    {
      "pattern": "kaleidoscope",
      "opacity": 0.35,
      "params": { "segments": 6, "zoom": 0.4, "complexity": 2, "line_width": 0.005 },
      "animation": { "speed": 0.125, "rotation": -0.0625, "hue_cycles": 0.0625 }
    }
  ],
  "post": {
    "exposure": 1.1, "bloom": 0.65, "bloom_radius": 1.25,
    "vignette": 0.5, "grain": 0.018, "chromatic_aberration": 0.0012,
    "saturation": 1.1, "contrast": 1.1
  }
}
