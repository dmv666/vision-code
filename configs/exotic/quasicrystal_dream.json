{
  "output": {
    "path": "renders/quasicrystal_dream.mp4",
    "width": 3840,
    "height": 2160,
    "fps": 60,
    "codec": "hevc",
    "quality": "high",
    "hardware": "auto",
    "supersample": 2,
    "motion_blur": {
      "samples": 2,
      "shutter": 0.5
    }
  },
  "palette": {
    "preset": "neon",
    "intensity": 1.1,
    "cycle": {
      "palettes": [
        {
          "preset": "sunset"
        },
        {
          "preset": "ice"
        }
      ],
      "repeats": 1,
      "transition": 0.4
    }
  },
  "animation": {
    "bpm": 120,
    "bars": 16,
    "speed": 0.125,
    "rotation": 0.0156,
    "wobble": 0.0313,
    "hue_cycles": 0,
    "pulse_strength": 0.5,
    "pulse_decay": 4.0
  },
  "layers": [
    {
      "pattern": "quasicrystal",
      "params": {
        "waves": 7,
        "frequency": 5.0,
        "sharpness": 0.7,
        "warp": 0.8,
        "bands": 6
      }
    }
  ],
  "post": {
    "exposure": 1.05,
    "bloom": 0.6,
    "bloom_radius": 1.2,
    "vignette": 0.4,
    "grain": 0.012,
    "chromatic_aberration": 0.0015,
    "saturation": 1.1,
    "contrast": 1.05
  }
}
